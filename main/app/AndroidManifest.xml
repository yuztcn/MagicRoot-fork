<?xml version="1.0" encoding="utf-8"?>
<!-- 旧版残留清单：不参与构建。当前生效清单是
     main/compose-app/app/src/main/AndroidManifest.xml。
     本文件已与其漂移（缺 INTERNET/QUERY_ALL_PACKAGES、含废弃
     package=/versionCode 属性），仅作历史基线保留，勿据此改动。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aoki.magicroot"
    android:versionCode="12"
    android:versionName="1.0.5">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.resukisu.resukisu" />
        <package android:name="me.yuki.fina" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="com.rifsxd.ksunext" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="MagicRoot"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.aoki.magicroot.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:label="MagicRoot"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
